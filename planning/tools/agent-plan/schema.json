{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://qlabs.example/qlabs-catalog-sync/agent-plan/tasks.schema.json",
  "title": "QLabs Catalog Sync Agent Task Board",
  "description": "Machine-readable task board for coding agents, derived from the RM-01 implementation plan.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "roadmap_item", "tasks"],
  "properties": {
    "version": {
      "type": "integer",
      "description": "Schema/document version.",
      "const": 1
    },
    "roadmap_item": {
      "type": "string",
      "description": "The RM tag this board implements.",
      "pattern": "^RM-[0-9]{2}$"
    },
    "tasks": {
      "type": "array",
      "items": { "$ref": "#/$defs/task" }
    }
  },
  "$defs": {
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "wp", "title", "description", "model",
        "depends_on", "parallel", "owns_paths", "inputs",
        "dod", "verify", "status"
      ],
      "properties": {
        "id": {
          "type": "string",
          "description": "Task id from the plan, e.g. T3.5.",
          "pattern": "^T[0-9]+\\.[0-9]+$"
        },
        "wp": {
          "type": "string",
          "description": "Work package the task belongs to.",
          "pattern": "^WP[0-9]+$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "type": "string",
          "description": "Recommended model for this task.",
          "enum": ["opus", "sonnet", "haiku"]
        },
        "depends_on": {
          "type": "array",
          "description": "Task ids that must be status=done before this task is ready.",
          "items": {
            "type": "string",
            "pattern": "^T[0-9]+\\.[0-9]+$"
          },
          "uniqueItems": true
        },
        "parallel": {
          "type": "boolean",
          "description": "Whether this task may run concurrently with peers in its wave."
        },
        "owns_paths": {
          "type": "array",
          "description": "Files/dirs this task owns, so parallel agents do not collide.",
          "items": { "type": "string" },
          "minItems": 1
        },
        "inputs": {
          "type": "array",
          "description": "RS bundle docs/sections the agent should read for this task.",
          "items": { "type": "string" },
          "minItems": 1
        },
        "dod": {
          "type": "string",
          "description": "Objective definition of done.",
          "minLength": 1
        },
        "verify": {
          "type": "string",
          "description": "Runnable command that verifies the task.",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "enum": ["pending", "in_progress", "done", "blocked"]
        }
      }
    }
  }
}
